#include<stdio.h>
#include<stdlib.h>

int main(){
	int n, capacity;

	scanf("%d",&n);
	int *values = (int*)malloc(n * sizeof(int));
	int *weights = (int*)malloc(n * sizeof(int));

	for(int i=0; i < n; i++){
		scanf("%d", &values[i]);
	}
	for(int i=0;i < n; i++){
		scanf("%d", &weights[i]);
	}
	scanf("%d", &capacity);
	int *dp = (int *)calloc(capacity + 1, sizeof(int));

	for(int i = 0; i < n; i++){
		for(int w = capacity; w >= weights[i]; w--){
			int include = values[i] + dp[w - weights[i]];

			if(include > dp[w])
				dp[w] = include;
		}
	}
	printf("%d\n", dp[capacity]);

	free(values);
	free(weights);
	free(dp);

	return 0;
}
